# ============================================================
# 短剧平台 .gitignore
# ============================================================

# ====== 敏感配置（绝对不能提交）======
.env
.env.*
nginx/ssl/
nginx/
*.pem
*.key
*.p12
*.jks

# ====== Docker 部署产生的数据目录 ======
mysql-data/
redis-data/
logs/
uploads/
admin-dist/
h5-dist/
backups/

# ====== Java / Maven 后端 ======
backed/server/target/
backed/server/logs/
backed/server/uploads/
backed/uploads/
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*

# ====== 前端构建产物 ======
front/admin/dist/
front/uniapp/dist/
front/uniapp/unpackage/
front/**/dist/
node_modules/
.npm/
.pnpm-store/

# ====== IDE 与编辑器 ======
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
.sts4-cache/

# ====== 操作系统 ======
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ====== 日志与临时文件 ======
*.log
*.pid
*.seed
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ====== 测试与覆盖率 ======
coverage/
*.lcov
.nyc_output/

# ====== HBuilderX / uni-app ======
front/uniapp/.hbuilderx/
front/uniapp/manifest.local.json

# ====== 二进制压缩包 / 构建产物 ======
*.tar.gz
*.zip
*.tgz
*.7z

# ====== 非代码文件（仅保留源码）======
package-lock.json
yarn.lock
pnpm-lock.yaml
docs/
*.conf
docker-compose.yml
Dockerfile
.dockerignore
kyc-site/nginx/
kyc-site/server/data/
kyc-site/public/robots.txt

# ====== 图片 / 二进制资源 ======
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.ico
*.svg
*.webp

# ====== 文档 ======
*.md

# ====== SEO / 站点资源 ======
sitemap.xml
robots.txt

# ====== 其他 ======
*.tmp
*.temp
.cache/
*.local

# ====== AI 工具目录 ======
.trae/
.agents/

# ====== 二进制工具 ======
tools/
*.exe

# ====== 归档与测试数据 ======
archive/
platform-tools/
