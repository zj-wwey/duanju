# ============================================================
# 短剧平台 .gitignore（完整项目交接版）
# 仅排除构建产物、依赖缓存、IDE文件、数据目录
# 保留所有源码、配置、图片、文档等项目必需文件
# ============================================================

# ====== Docker 部署产生的数据目录 ======
mysql-data/
redis-data/
logs/
uploads/
admin-dist/
h5-dist/
backups/

# ====== Java / Maven 构建产物 ======
backed/server/target/
backed/server/logs/
backed/server/uploads/
backed/uploads/
*.class
*.jar
*.war
*.ear
hs_err_pid*

# ====== 前端构建产物 ======
front/admin/dist/
front/uniapp/dist/
front/uniapp/unpackage/
front/**/dist/
node_modules/
.npm/
.pnpm-store/

# ====== IDE 与编辑器 ======
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
.sts4-cache/

# ====== 操作系统 ======
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ====== 日志与临时文件 ======
*.log
*.pid
*.seed
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ====== 测试与覆盖率 ======
coverage/
*.lcov
.nyc_output/

# ====== HBuilderX / uni-app ======
front/uniapp/.hbuilderx/
front/uniapp/manifest.local.json

# ====== 二进制压缩包 / 构建产物 ======
*.tar.gz
*.zip
*.tgz
*.7z

# ====== SSL 证书（敏感，不提交）======
*.pem
*.key
*.p12
*.jks
nginx/ssl/

# ====== 其他临时文件 ======
*.tmp
*.temp
.cache/
*.local

# ====== AI 工具目录 ======
.trae/
.agents/

# ====== 二进制工具 ======
tools/
*.exe

# ====== 归档与测试数据 ======
archive/
platform-tools/
