<template>
  <view class="overlay">
    <view class="grad-top"></view>
    <view class="grad-bottom" :style="{ height: gradBottomHeight + 'rpx' }"></view>

    <view class="topbar">
      <scroll-view scroll-x class="tabs" :scroll-into-view="scrollTo">
        <view class="tab" :class="{ active: !categoryId }" @click="emit('category', null)">
          <text class="tab-text" :class="{ active: !categoryId }">{{ allText }}</text>
        </view>
        <view v-for="item in categories" :key="item.id" class="tab" :class="{ active: categoryId === item.id }" @click="emit('category', item.id)">
          <text class="tab-text" :class="{ active: categoryId === item.id }">{{ item.name }}</text>
        </view>
      </scroll-view>
      <text class="nav-btn browse-btn" @click="emit('browse')">{{ browseText }}</text>
      <text class="nav-btn" @click="emit('profile')">{{ profileText }}</text>
    </view>

    <view class="actions" :style="{ bottom: actionsBottom + 'rpx' }">
      <view class="action" @click="emit('favorite')">
        <text class="action-icon" :style="{ color: favorite ? '#ff4d67' : '#ffffff' }">{{ favorite ? '♥' : '♡' }}</text>
        <text class="action-label">{{ favoriteText }}</text>
      </view>
      <view class="action" @click="emit('like')">
        <text class="action-icon">★</text>
        <text class="action-label">{{ likeText }}</text>
      </view>
      <view class="action" @click="emit('comment')">
        <text class="action-icon">✦</text>
        <text class="action-label">{{ commentText }}</text>
      </view>
      <view class="action" @click="emit('share')">
        <text class="action-icon">↗</text>
        <text class="action-label">{{ shareText }}</text>
      </view>
      <view class="action" @click="emit('details')">
        <text class="action-icon">☰</text>
        <text class="action-label">{{ detailsText }}</text>
      </view>
    </view>

    <view class="bottom" :style="{ bottom: bottomY + 'rpx' }">
      <text class="title">{{ dramaTitle }}</text>
      <text class="desc" v-if="episodeDesc">{{ episodeDesc }}</text>
      <view class="episode-pill" @click="emit('episode')">
        <text class="episode-text">{{ episodeBrowseText }}</text>
      </view>
    </view>

    <view class="progress-bar" :style="{ bottom: progressBottom + 'rpx' }">
      <view class="progress-fill" :style="{ width: progressPercent + '%' }"></view>
    </view>
  </view>
</template>

<script>
export default {
  data() {
    return {
      categories: [],
      categoryId: null,
      allText: 'All',
      favorite: false,
      favoriteText: 'Save',
      likeText: 'Like',
      commentText: 'Comment',
      shareText: 'Share',
      detailsText: 'Details',
      browseText: 'Browse',
      profileText: 'Profile',
      episodeBrowseText: '',
      dramaTitle: '',
      episodeDesc: '',
      episodeNo: 1,
      total: 0,
      progressPercent: 0,
      scrollTo: '',
      progressBottom: 90,
      bottomY: 100,
      actionsBottom: 280,
      gradBottomHeight: 420
    }
  },
  created() {
    try {
      const sys = uni.getSystemInfoSync()
      const ratio = 750 / sys.windowWidth
      const safeBottom = sys.screenHeight - (sys.safeArea ? sys.safeArea.bottom : sys.screenHeight)
      const safeRpx = safeBottom * ratio
      const tabBarH = 80 + safeRpx
      this.progressBottom = Math.round(tabBarH + 6)
      this.bottomY = Math.round(tabBarH + 16)
      this.actionsBottom = Math.round(tabBarH + 196)
      this.gradBottomHeight = Math.round(tabBarH + 320)
    } catch (e) {}
    const self = this
    uni.$on('updateOverlay', function(data) {
      if (data.categories !== undefined) self.categories = data.categories
      if (data.categoryId !== undefined) self.categoryId = data.categoryId
      if (data.allText !== undefined) self.allText = data.allText
      if (data.favorite !== undefined) self.favorite = data.favorite
      if (data.favoriteText !== undefined) self.favoriteText = data.favoriteText
      if (data.likeText !== undefined) self.likeText = data.likeText
      if (data.commentText !== undefined) self.commentText = data.commentText
      if (data.shareText !== undefined) self.shareText = data.shareText
      if (data.detailsText !== undefined) self.detailsText = data.detailsText
      if (data.browseText !== undefined) self.browseText = data.browseText
      if (data.profileText !== undefined) self.profileText = data.profileText
      if (data.episodeBrowseText !== undefined) self.episodeBrowseText = data.episodeBrowseText
      if (data.dramaTitle !== undefined) self.dramaTitle = data.dramaTitle
      if (data.episodeDesc !== undefined) self.episodeDesc = data.episodeDesc
      if (data.episodeNo !== undefined) self.episodeNo = data.episodeNo
      if (data.total !== undefined) self.total = data.total
      if (data.progressPercent !== undefined) self.progressPercent = data.progressPercent
    })
  },
  beforeDestroy() {
    uni.$off('updateOverlay')
  },
  methods: {
    emit(type, data) {
      uni.$emit('overlayEvent', { type, data })
    }
  }
}
</script>

<style>
.overlay {
  flex: 1;
  background-color: transparent;
  pointer-events: none;
}

.grad-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background-image: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,0,0,0));
  pointer-events: none;
}

.grad-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-image: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2) 40%, rgba(0,0,0,0));
  pointer-events: none;
}

.topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  flex-direction: row;
  align-items: center;
  padding-left: 16rpx;
  padding-right: 16rpx;
  padding-top: 10rpx;
  background-image: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,0,0,0));
  pointer-events: auto;
}

.tabs {
  flex: 1;
  flex-direction: row;
  height: 48rpx;
}

.tab {
  height: 48rpx;
  margin-right: 10rpx;
  padding-left: 18rpx;
  padding-right: 18rpx;
  justify-content: center;
  align-items: center;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.08);
}

.tab.active {
  background-color: #f3b84d;
}

.tab-text {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.72);
}

.tab-text.active {
  color: #07080d;
}

.nav-btn {
  width: 72rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 8rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.15);
}

.browse-btn {
  color: #07080d;
  background-color: #f3b84d;
}

.actions {
  position: absolute;
  right: 16rpx;
  flex-direction: column;
  align-items: center;
  pointer-events: auto;
}

.action {
  width: 96rpx;
  margin-bottom: 24rpx;
  justify-content: center;
  align-items: center;
}

.action-icon {
  font-size: 48rpx;
  text-align: center;
  color: #ffffff;
}

.action-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  margin-top: 4rpx;
}

.bottom {
  position: absolute;
  left: 24rpx;
  right: 130rpx;
  pointer-events: auto;
}

.title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  lines: 2;
  text-overflow: ellipsis;
}

.desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
  lines: 1;
  text-overflow: ellipsis;
}

.episode-pill {
  margin-top: 12rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
  flex-direction: row;
  align-items: center;
  align-self: flex-start;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.episode-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
}

.progress-bar {
  position: absolute;
  left: 0;
  right: 0;
  height: 4rpx;
  background-color: rgba(255, 255, 255, 0.15);
}

.progress-fill {
  height: 4rpx;
  background-image: linear-gradient(to right, #ffe0a1, #f3b84d);
}
</style>
