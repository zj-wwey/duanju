<template>
  <view class="overlay">
    <view class="grad-top"></view>
    <view class="grad-bottom"></view>

    <view class="back-btn" @click="emit('back')">
      <text class="back-text">‹</text>
    </view>

    <view class="actions">
      <view class="action" @click="emit('favorite')">
        <text class="action-icon" :style="{ color: favorite ? '#ff4d67' : '#ffffff' }">{{ favorite ? '♥' : '♡' }}</text>
        <text class="action-label">{{ favoriteText }}</text>
      </view>
      <view class="action" @click="emit('like')">
        <text class="action-icon">★</text>
        <text class="action-label">{{ likeText }}</text>
      </view>
      <view class="action" @click="emit('comment')">
        <text class="action-icon">✦</text>
        <text class="action-label">{{ commentText }}</text>
      </view>
      <view class="action" @click="emit('share')">
        <text class="action-icon">↗</text>
        <text class="action-label">{{ shareText }}</text>
      </view>
      <view class="action" @click="emit('details')">
        <text class="action-icon">☰</text>
        <text class="action-label">{{ detailsText }}</text>
      </view>
    </view>

    <view class="bottom">
      <text class="title">{{ dramaTitle }}</text>
      <text class="desc" v-if="episodeTitle">{{ episodeTitle }}</text>
    </view>

    <view class="episode-bar" @click="emit('episode')">
      <text class="episode-text">{{ episodeBrowseText }}</text>
    </view>

    <view class="progress-bar">
      <view class="progress-fill" :style="{ width: progressPercent + '%' }"></view>
    </view>
  </view>
</template>

<script>
export default {
  data() {
    return {
      favorite: false,
      favoriteText: 'Save',
      likeText: 'Like',
      commentText: 'Comment',
      shareText: 'Share',
      detailsText: 'Details',
      episodeBrowseText: '',
      dramaTitle: '',
      episodeTitle: '',
      episodeNo: 1,
      total: 0,
      progressPercent: 0
    }
  },
  created() {
    const self = this
    uni.$on('updatePlayerOverlay', function(data) {
      if (data.favorite !== undefined) self.favorite = data.favorite
      if (data.favoriteText !== undefined) self.favoriteText = data.favoriteText
      if (data.likeText !== undefined) self.likeText = data.likeText
      if (data.commentText !== undefined) self.commentText = data.commentText
      if (data.shareText !== undefined) self.shareText = data.shareText
      if (data.detailsText !== undefined) self.detailsText = data.detailsText
      if (data.episodeBrowseText !== undefined) self.episodeBrowseText = data.episodeBrowseText
      if (data.dramaTitle !== undefined) self.dramaTitle = data.dramaTitle
      if (data.episodeTitle !== undefined) self.episodeTitle = data.episodeTitle
      if (data.episodeNo !== undefined) self.episodeNo = data.episodeNo
      if (data.total !== undefined) self.total = data.total
      if (data.progressPercent !== undefined) self.progressPercent = data.progressPercent
    })
  },
  beforeDestroy() {
    uni.$off('updatePlayerOverlay')
  },
  methods: {
    emit(type) {
      uni.$emit('playerOverlayEvent', { type })
    }
  }
}
</script>

<style>
.overlay {
  flex: 1;
  background-color: transparent;
  pointer-events: none;
}

.grad-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background-image: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,0,0,0));
  pointer-events: none;
}

.grad-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background-image: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2) 40%, rgba(0,0,0,0));
  pointer-events: none;
}

.back-btn {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 56rpx;
  height: 56rpx;
  justify-content: center;
  align-items: center;
  pointer-events: auto;
}

.back-text {
  font-size: 48rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.9);
}

.actions {
  position: absolute;
  right: 16rpx;
  bottom: 260rpx;
  flex-direction: column;
  align-items: center;
  pointer-events: auto;
}

.action {
  width: 96rpx;
  margin-bottom: 24rpx;
  justify-content: center;
  align-items: center;
}

.action-icon {
  font-size: 48rpx;
  text-align: center;
  color: #ffffff;
}

.action-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  margin-top: 4rpx;
}

.bottom {
  position: absolute;
  left: 24rpx;
  right: 120rpx;
  bottom: 80rpx;
  pointer-events: auto;
}

.title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
  lines: 1;
  text-overflow: ellipsis;
}

.episode-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 56rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  flex-direction: row;
  align-items: center;
  background-image: linear-gradient(to top, rgba(0,0,0,0.65), rgba(0,0,0,0.35));
  pointer-events: auto;
}

.episode-text {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
}

.progress-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 56rpx;
  height: 4rpx;
  background-color: rgba(255, 255, 255, 0.15);
}

.progress-fill {
  height: 4rpx;
  background-image: linear-gradient(to right, #ffe0a1, #f3b84d);
}
</style>
