# ============================================================
# 短剧平台 - Web 管理端生产环境配置
# 安全子域名方案 A（避免暴露业务含义）：
#   srv.marastel.com  = API 后端接口
#   dash.marastel.com = Web 管理后台
#   web.marastel.com  = H5 移动端
# ============================================================

# API 后端地址：使用相对路径 /api，让浏览器请求 dash.marastel.com/api/xxx
# 由 Nginx 的 location /api/ 反代到后端，避免跨域问题
VITE_API_BASE_URL=/api

# 部署到独立子域名（dash.marastel.com），base 为默认 /
# 若将来改为子路径部署，取消下方注释并调整
# VITE_BASE_PATH=/admin/
# VITE_API_BASE_URL=https://srv.marastel.com/api
