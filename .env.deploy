# ============================================================
# 短剧平台 - 服务器部署环境变量（已填真实凭证，直接 cp 到服务器 /opt/duanju-api/.env 用）
# ============================================================
# 安全子域名方案 A：
#   srv.marastel.com  = API 后端接口
#   dash.marastel.com = Web 管理后台
#   web.marastel.com  = H5 移动端
#   cdn.marastel.com  = 静态资源/CDN（头像/封面/上传 + R2 反代）
# ============================================================

# ====== MySQL 数据库 ======
MYSQL_ROOT_PASSWORD=Kp$7sQ9!vB2@zR5#mG8^dN4&
DB_USERNAME=root
DB_PASSWORD=Kp$7sQ9!vB2@zR5#mG8^dN4&
DB_URL=jdbc:mysql://mysql:3306/duanju?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Singapore

# ====== Redis ======
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=R3d!sK9vL2@xQ6#mN8^pT4&

# ====== JWT 密钥（至少 32 字符，生产环境务必更换）======
DUANJU_AUTH_SECRET=Pj3FwXr8Bn4Tm6Zq9Vk2Hs7Cy1Lf5Ga0Ud8Ne9Jx2Qr6Sg3

# ====== CORS 白名单（跨域请求来源，CDN 是静态资源域名不需要请求 API，保留两个业务域名）======
DUANJU_CORS_ALLOWED_ORIGINS=https://dash.marastel.com,https://web.marastel.com

# ====== 存储配置 ======
# DUANJU_STORAGE_PROVIDER=cloudflare 表示视频走 Stream，图片走 R2（本套配置已启用）
DUANJU_STORAGE_PROVIDER=cloudflare
# 本地存储模式下上传文件的公开访问 URL（cdn 子域名独立分发，不共用 API 域）
DUANJU_STORAGE_PUBLIC_BASE_URL=https://cdn.marastel.com/uploads
DUANJU_STORAGE_LOCAL_UPLOAD_DIR=/app/uploads

# ====== Cloudflare Stream 视频托管 ======
CLOUDFLARE_ENABLED=true
CLOUDFLARE_ACCOUNT_ID=038615e6f6f1d9223c6aecc6f7956e68
CLOUDFLARE_API_TOKEN=cfut_LulObZCTBpRTyXXB5RoFVz2GdjVntl85CW9Rmw9N028d2d25
CLOUDFLARE_SIGNING_
# 签名 URL 有效期（秒）
CLOUDFLARE_SIGNED_URL_TTL_SECONDS=3600
# HLS 播放列表路径前缀
CLOUDFLARE_HLS_PATH_PREFIX=https://watch.cloudflarestream.com
# 上传超时（秒）
CLOUDFLARE_UPLOAD_TIMEOUT_SECONDS=3600
# Webhook 鉴权 Bearer Token（Dashboard → Stream → Settings → Webhooks 保持一致）
CLOUDFLARE_WEBHOOK_AUTH_TOKEN=dae1806bbe0d6282bb729fe7a382fe1ae409bd7
# VPS 中转批量上传目录
CLOUDFLARE_BATCH_UPLOAD_DIR=/opt/duanju/batch-upload
CLOUDFLARE_BATCH_UPLOAD_CONCURRENCY=3
# TUS 断点续传调优
CLOUDFLARE_DIRECT_UPLOAD_THRESHOLD=209715200
CLOUDFLARE_TUS_CHUNK_SIZE=5242880
CLOUDFLARE_TUS_MAX_RETRIES=3
CLOUDFLARE_TUS_RETRY_BASE_INTERVAL=1000

# ====== Cloudflare R2 对象存储（头像/封面/视频直传，通过 cdn.marastel.com 对外暴露）======
# 注意：变量名必须与 application.yml 中的 ${...} 完全一致，否则读不到值 R2 自动禁用
R2_ENABLED=true
CLOUDFLARE_R2_ACCOUNT_ID=038615e6f6f1d9223c6aecc6f7956e68
CLOUDFLARE_R2_ACCESS_KEY_ID=000d1399219db3476894216722331872
CLOUDFLARE_R2_SECRET_ACCESS_KEY=d7892a2fc2f6a50ae92b0fe9b2da17fba18ff5ccb6b65c3306b7aebee4430158
CLOUDFLARE_R2_BUCKET=duanju
CLOUDFLARE_R2_ENDPOINT=https://038615e6f6f1d9223c6aecc6f7956e68.r2.cloudflarestorage.com
# 重要：末尾不要加 /r2 等虚拟路径，R2 自定义域名直接映射到桶根路径
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://cdn.marastel.com

# ====== Stripe 沙箱支付 (Web Checkout) ======
# 测试模式开关;上线切真实账户时改为 true 且替换 sk_live_ / whsec_ 生产值
STRIPE_ENABLED=true
# 沙箱 Secret Key (sk_test_ 开头);生产必须换成 sk_live_ 并通过环境变量注入
STRIPE_SECRET_KEY=sk_test_51U5gMBGybsJxjPhBdBaaaRD8D09i6KR352BnyczaL9xceAkgXlSaqHLHffTuCQkh9HdbnVcGhQHTyBesM3JakYGz00Kl1zA9jm
# Stripe Dashboard → Developers → Webhooks → 对应 srv.marastel.com endpoint 的 Signing secret
STRIPE_WEBHOOK_SECRET=whsec_HlpMxsNFf9fklQaL6H503DxzO4LTME3D
# 支付成功/取消跳转地址 (Checkout Session success_url / cancel_url)
# 必须是公开可访问的域名,srv.marastel.com 已由 nginx 反代到 /api/webhooks/stripe/return
STRIPE_SUCCESS_URL=https://srv.marastel.com/api/webhooks/stripe/return
STRIPE_CANCEL_URL=https://srv.marastel.com/api/webhooks/stripe/return

APPLE_IAP_ENABLED=false
GOOGLE_PAL_ENABLED=false
PAYPAL_ENABLED=false

# ====== 上传限制 ======
UPLOAD_MAX_FILE_SIZE=1024MB
UPLOAD_MAX_REQUEST_SIZE=1024MB
SERVER_PORT=8080

# ====== Spring Profile ======
SPRING_PROFILES_ACTIVE=prod

# ====== 时区 ======
TZ=Asia/Singapore
